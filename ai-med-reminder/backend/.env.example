# Server
PORT=5000

# JWT secret - change this to any long random string
JWT_SECRET=medimind_super_secret_change_me

# Anthropic API key - optional. If left empty, the chatbot uses safe offline
# fallback replies instead of calling the AI model.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Which Claude model to use for the chatbot
ANTHROPIC_MODEL=claude-sonnet-4-6
